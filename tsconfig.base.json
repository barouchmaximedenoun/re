{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "paths": {
      "@platform/identity": ["./libs/platform/identity/src/index.ts"],
      "@platform/errors": ["./libs/platform/errors/src/index.ts"],
      "@clients/http": ["./libs/clients/http"],
      "@infra/db": ["./libs/infra/db/src/index.ts"]
    }
  }
}
